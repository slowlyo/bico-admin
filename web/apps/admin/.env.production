VITE_BASE=./

# 接口地址，生产环境由网关转发到 Go 后台
VITE_GLOB_API_URL=/admin-api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 产物由 Go 直接嵌入 web/dist，不需要 zip（归档插件只会打包应用目录下的 dist，得到空压缩包）
VITE_ARCHIVER=false
